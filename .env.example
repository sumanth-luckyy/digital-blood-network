# BloodLink — Digital Blood Donation Emergency Network
# Environment Configuration Template

# Public client-safe keys for Vite frontend
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_AI_SERVICE_URL=http://localhost:8000

# Server-side privileged secrets (Used only in Supabase Edge Functions & FastAPI)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
AI_SERVICE_SECRET_KEY=your-internal-api-secret

# Firebase Cloud Messaging (Optional Web Push)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
